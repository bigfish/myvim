keybind = ctrl+alt+t=new_tab

keybind = ctrl+alt+g>1=goto_tab:1
keybind = ctrl+alt+g>2=goto_tab:2
keybind = ctrl+alt+g>3=goto_tab:3
keybind = ctrl+alt+g>4=goto_tab:4
keybind = ctrl+alt+g>5=goto_tab:5
keybind = ctrl+alt+g>6=goto_tab:6
keybind = ctrl+alt+g>7=goto_tab:7
keybind = ctrl+alt+g>8=goto_tab:8
keybind = ctrl+alt+g>9=goto_tab:9
keybind = ctrl+alt+o=toggle_tab_overview
keybind = ctrl+alt+r=prompt_surface_title

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+alt+w=close_surface

keybind = ctrl+alt+h=new_split:down
keybind = ctrl+alt+v=new_split:right

keybind = ctrl+alt+p=goto_split:previous
keybind = ctrl+alt+n=goto_split:next

keybind = ctrl+alt+l=resize_split:up,10
keybind = ctrl+shift+l=resize_split:down,10

keybind = ctrl+-=resize_split:right,10
keybind = ctrl+shift+-=resize_split:left,10

keybind = ctrl+alt+e=equalize_splits
keybind = ctrl+alt+z=toggle_split_zoom
keybind = ctrl+alt+m=toggle_maximize
keybind = ctrl+alt+f=toggle_fullscreen
keybind = ctrl+alt+q=quit
keybind = ctrl+alt+c=toggle_command_palette

keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_right=goto_split:right

keybind = ctrl+alt+.=reload_config
